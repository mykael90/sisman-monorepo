// Enum para controlar o tipo de resposta esperada
enum SurveyQuestionType {
    RATING   @map("NOTA") // De 1 a 10 (ou 1 a 5)
    TEXT     @map("LIVRE") // Texto livre
    BOOLEAN  @map("BOLEANO") // Sim/Não
    MULTIPLE @map("MULTIPLA") // Múltipla escolha (opcional, requer mais uma tabela de Options)
    SINGLE   @map("UNICA") // Única escolha (opcional, requer mais uma tabela de Options)   
}

// 1. A Definição da Pesquisa (O "Header" conceitual do modelo, mas focado no TEMA)
model Survey {
    id                 String   @id @default(uuid())
    title              String
    description        String?  @db.Text
    isActive           Boolean  @default(true)
    createdAt          DateTime @default(now()) @db.Timestamp(0) // Timestamp for when the user record was created.
    updatedAt          DateTime @updatedAt @db.Timestamp(0) // Timestamp for the last update of the user record.
    showModal          Boolean  @default(false)
    uniqueAnswerByUser Boolean  @default(false)

    // Relacionamentos

    questions SurveyQuestion[]
    responses SurveyResponse[]

    @@map("surveys")
}

// 2. As Perguntas (Definição do que será perguntado)
model SurveyQuestion {
    id       String             @id @default(uuid())
    text     String // O enunciado da pergunta
    order    Int // Para ordenar as perguntas na tela (1, 2, 3...)
    type     SurveyQuestionType @default(RATING)
    required Boolean            @default(true)

    surveyId String
    survey   Survey @relation(fields: [surveyId], references: [id])

    answers               SurveyAnswer[] // Relacionamento inverso para análises
    surveyQuestionOptions SurveyQuestionOptions[]

    @@map("survey_questions")
}

model SurveyQuestionOptions {
    id       String  @id @default(uuid())
    label    String // Texto exibido (ex: "Muito satisfeito")
    value    String // Valor lógico (ex: "VERY_SATISFIED")
    order    Int
    isActive Boolean @default(true)

    // Relacionamento
    questionId String
    question   SurveyQuestion @relation(fields: [questionId], references: [id])

    answers SurveyAnswerOption[]

    @@unique([questionId, value])
    @@map("survey_question_options")
}

// 3. O Cabeçalho da Resposta (Quem respondeu e quando)
// Isso substitui o seu "Header" original no contexto da resposta
model SurveyResponse {
    id          String   @id @default(uuid())
    completedAt DateTime @default(now()) @db.Timestamp(0) // Timestamp for when the user record was created.

    // Relacionamento com seu usuário existente
    userId Int
    user   User @relation(fields: [userId], references: [id])

    surveyId String
    survey   Survey @relation(fields: [surveyId], references: [id])

    answers SurveyAnswer[]

    @@map("survey_responses")
}

// 4. As Respostas Individuais (Substitui a tabela "Score")
// Aqui cada linha é UMA resposta para UMA pergunta
model SurveyAnswer {
    id String @id @default(uuid())

    // O valor da resposta. Usamos colunas opcionais para flexibilidade
    intValue    Int? // Para notas de 1 a 10
    stringValue String? // Para comentários em texto
    boolValue   Boolean? // Para Sim/Não

    // Relacionamentos
    questionId String
    question   SurveyQuestion @relation(fields: [questionId], references: [id])

    responseId String
    response   SurveyResponse @relation(fields: [responseId], references: [id])

    options SurveyAnswerOption[]

    @@unique([responseId, questionId]) // Garante que o usuário só responde 1x a mesma pergunta na mesma submissão
    @@map("survey_answers")
}

model SurveyAnswerOption {
    id String @id @default(uuid())

    answerId String
    answer   SurveyAnswer @relation(fields: [answerId], references: [id])

    optionId String
    option   SurveyQuestionOptions @relation(fields: [optionId], references: [id])

    @@unique([answerId, optionId])
    @@map("survey_answer_options")
}
