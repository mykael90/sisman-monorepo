### Variables
@urlLocal = {{apiUrl}}/survey
@contentType = application/json

### GET all surveys
GET {{urlLocal}}
Authorization: Bearer {{token}}

### GET all surveys with query params
GET {{urlLocal}}
?showModal=true
Authorization: Bearer {{token}}

### GET one survey
# @prompt surveyId
GET {{urlLocal}}/{{surveyId}}
Authorization: Bearer {{token}}

### POST create survey (Simples)
POST {{urlLocal}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
    "title": "Pesquisa de Satisfação",
    "description": "Uma pesquisa para medir a satisfação geral."
}

### POST create survey WITH RELATIONS (Sem Opções)
POST {{urlLocal}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
    "title": "Pesquisa de Clima Organizacional 1",
    "description": "Avaliação do clima na organização.",
    "uniqueAnswerByUser": true,
    "questions": [
        {
            "text": "Como você avalia o ambiente de trabalho?",
            "order": 1,
            "type": "RATING",
            "required": true
        },
        {
            "text": "Qual seu nível de satisfação com a liderança?",
            "order": 2,
            "type": "TEXT",
            "required": false
        }
    ]
}

### POST create survey WITH RELATIONS (Completa com Opções)
# Use este endpoint para criar dados de massa para testar o update complexo abaixo
POST {{urlLocal}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
    "title": "Pesquisa de Produto 2024",
    "description": "Pesquisa base para teste de edição complexa.",
    "questions": [
        {
            "text": "Qual cor você prefere?",
            "order": 1,
            "type": "MULTIPLE",
            "required": true,
            "surveyQuestionOptions": [
                { "label": "Azul", "value": "blue", "order": 1 },
                { "label": "Vermelho", "value": "red", "order": 2 },
                { "label": "Verde (Para Deletar)", "value": "green", "order": 3 }
            ]
        },
        {
            "text": "Pergunta para ser deletada no update",
            "order": 2,
            "type": "TEXT",
            "required": false
        }
    ]
}

# ==============================================================================
# CENÁRIOS DE UPDATE (PUT)
# ==============================================================================

### PUT Update Simples (Apenas escalares)
# @prompt surveyId
PUT {{urlLocal}}/{{surveyId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
    "title": "Título Atualizado via PUT",
    "description": "Descrição atualizada, sem mexer nas questões."
}


### PUT Update Complexo (Reconciliação / Diff)
# @prompt surveyId
# @prompt questionIdToUpdate ID da pergunta 'Qual cor você prefere?' (copie do GET)
# @prompt optionIdToUpdate ID da opção 'Azul' (copie do GET)
PUT {{urlLocal}}/{{surveyId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
    "title": "Pesquisa Atualizada (FULL DIFF)",
    "description": "Testando: Update de Pergunta, Delete de Pergunta, Create de Pergunta, Update de Opção, Delete de Opção.",
    "questions": [
        {
            "id": "{{questionIdToUpdate}}", 
            "text": "Qual cor você prefere? (Texto Editado)",
            "order": 2, 
            "type": "MULTIPLE",
            "required": true,
            "surveyQuestionOptions": [
                {
                    "id": "{{optionIdToUpdate}}",
                    "label": "Azul (Label Editada)",
                    "value": "blue-updated",
                    "order": 1
                },
                {
                    "label": "Amarelo (Nova Opção Criada)",
                    "value": "yellow",
                    "order": 2
                }
                
                // NOTA: A opção 'Vermelho' e 'Verde' foram omitidas, 
                // logo, devem ser DELETADAS do banco automaticamente.
            ]
        },
        {
            // SEM ID = CRIAÇÃO
            "text": "Nova Pergunta (Adicionada no Update)",
            "order": 3,
            "type": "RATING",
            "required": false
        }
        
        // NOTA: A pergunta "Pergunta para ser deletada no update" (order 2 original) 
        // foi omitida da lista, logo, deve ser DELETADA do banco automaticamente.
    ]
}

### DELETE survey
# @prompt surveyId
DELETE {{urlLocal}}/{{surveyId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

### POST create survey WITH RELATIONS (Avaliação SISMAN)
POST {{urlLocal}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
    "title": "Questionário de Avaliação do SISMAN: (Interface e Usabilidade)",
    "description": "Este questionário tem como objetivo coletar a percepção dos usuários sobre a interface e a usabilidade do sistema web SISMAN. As respostas contribuirão para a avaliação e o aprimoramento da plataforma. Não há identificação individual dos participantes.",
    "questions": [
                        {
                        "text": "Qual forma de autenticação você utiliza no sistema?",
                        "order": 1,
                        "type": "SINGLE",
                        "required": true,
                        "surveyQuestionOptions": [
                        { "label": "Credenciais SIPAC", "value": "sipac", "order": 1 },
                        { "label": "Código único enviado por e-mail", "value": "email_code", "order": 2 }
                        ]
                        },
                        {
                        "text": "Quão fácil foi realizar a autenticação e o primeiro acesso ao sistema? *(1: Muito difícil — 5: Muito fácil)*",
                        "order": 2,
                        "type": "RATING",
                        "required": true
                        },
                        {
                        "text": "Senti-me confiante ao utilizar o sistema sem a necessidade de consultar manual ou ajuda externa.",
                        "order": 3,
                        "type": "BOOLEAN",
                        "required": true
                        },
                        {
                        "text": "A organização visual das informações facilita a identificação dos elementos mais importantes na tela. *(1: Discordo totalmente — 5: Concordo totalmente)*",
                        "order": 4,
                        "type": "RATING",
                        "required": true
                        },
                        {
                        "text": "Como você avalia a paleta de cores e o contraste do sistema?",
                        "order": 5,
                        "type": "SINGLE",
                        "required": true,
                        "surveyQuestionOptions": [
                        { "label": "Excelente, favorece a leitura e o uso prolongado.", "value": "excellent", "order": 1 },
                        { "label": "Adequada, porém cansativa após longos períodos de uso.", "value": "adequate", "order": 2 },
                        { "label": "Insatisfatória, dificulta a distinção entre textos e botões.", "value": "unsatisfactory", "order": 3 }
                        ]
                        },
                        {
                        "text": "Os ícones utilizados no sistema são intuitivos e representam adequadamente suas funcionalidades.",
                        "order": 6,
                        "type": "BOOLEAN",
                        "required": true
                        },
                        {
                        "text": "O sistema indica claramente a seção ou página em que o usuário se encontra.",
                        "order": 7,
                        "type": "BOOLEAN",
                        "required": true
                        },
                        {
                        "text": "Ao clicar em links ou botões, o comportamento do sistema correspondeu às suas expectativas?",
                        "order": 8,
                        "type": "SINGLE",
                        "required": true,
                        "surveyQuestionOptions": [
                        { "label": "Sim, sempre.", "value": "always", "order": 1 },
                        { "label": "Na maioria das vezes.", "value": "mostly", "order": 2 },
                        { "label": "Raramente.", "value": "rarely", "order": 3 }
                        ]
                        },
                        {
                        "text": "Quando ocorre um erro, o sistema apresenta mensagens claras e compreensíveis. *(1: Discordo totalmente — 5: Concordo totalmente)*",
                        "order": 9,
                        "type": "RATING",
                        "required": true
                        },
                        {
                        "text": "Após a realização de uma ação importante, o sistema apresenta algum tipo de confirmação visual (ex.: mensagem ou indicador de carregamento).",
                        "order": 10,
                        "type": "BOOLEAN",
                        "required": true
                        },
                        {
                        "text": "Se fosse possível modificar apenas uma interação no sistema para torná-lo mais simples ou eficiente, qual seria?",
                        "order": 11,
                        "type": "TEXT",
                        "required": false
                        }
                ]
}

### POST create survey WITH RELATIONS (Avaliação SISMAN)
POST {{urlLocal}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "title": "Avaliação do SISMAN: Módulo de Materiais",
  "description": "Este questionário tem como objetivo avaliar a adequação funcional, a eficácia operacional e o impacto institucional do módulo de materiais do sistema SISMAN. As respostas são anônimas e serão utilizadas exclusivamente para fins de avaliação e melhoria do sistema.",
  "questions": [
    {
      "text": "Quais operações relacionadas a materiais você realiza no SISMAN? (Marque todas as opções aplicáveis)",
      "order": 1,
      "type": "MULTIPLE",
      "required": true,
      "surveyQuestionOptions": [
        { "label": "Reserva de materiais", "value": "reserva", "order": 1 },
        { "label": "Recebimento de materiais", "value": "recebimento", "order": 2 },
        { "label": "Retirada de materiais", "value": "retirada", "order": 3 },
        { "label": "Contagem de estoque", "value": "contagem", "order": 4 },
        { "label": "Restrição de materiais", "value": "restricao", "order": 5 }
      ]
    },
    {
      "text": "Você realiza consultas aos dados de materiais do SISMAN em sua rotina operacional?",
      "order": 2,
      "type": "BOOLEAN",
      "required": true
    },
    {
      "text": "O fluxo operacional do sistema para a realização de reservas é coerente com a rotina real do depósito?",
      "order": 3,
      "type": "SINGLE",
      "required": true,
      "surveyQuestionOptions": [
        { "label": "Sim, reflete adequadamente a rotina diária.", "value": "sim", "order": 1 },
        { "label": "Parcialmente, exigindo adaptações operacionais.", "value": "parcialmente", "order": 2 },
        { "label": "Não, o fluxo do sistema é distante da prática cotidiana.", "value": "nao", "order": 3 },
        { "label": "N/A. Não utilizo essa funcionalidade.", "value": "na", "order": 4 }
      ]
    },
    {
      "text": "Qual foi o impacto da implementação da lógica de reservas em relação ao tempo de atendimento no balcão para retirada de materiais?",
      "order": 4,
      "type": "SINGLE",
      "required": true,
      "surveyQuestionOptions": [
        { "label": "Houve grande redução do tempo gasto.", "value": "grande_reducao", "order": 1 },
        { "label": "Houve pequena redução do tempo gasto.", "value": "pequena_reducao", "order": 2 },
        { "label": "Não houve alteração perceptível.", "value": "sem_alteracao", "order": 3 },
        { "label": "Houve aumento do tempo gasto.", "value": "aumento", "order": 4 },
        { "label": "N/A. Não acompanho essa rotina.", "value": "na", "order": 5 }
      ]
    },
    {
      "text": "A implantação do SISMAN contribuiu para a redução do tempo de abastecimento da frota destinada às rotas de entrega?",
      "order": 5,
      "type": "SINGLE",
      "required": true,
      "surveyQuestionOptions": [
        { "label": "Sim", "value": "sim", "order": 1 },
        { "label": "Não", "value": "nao", "order": 2 },
        { "label": "N/A. Não acompanho essa rotina", "value": "na", "order": 3 }
      ]
    },
    {
      "text": "O fluxo operacional do sistema para recebimentos e retiradas de materiais é coerente com a rotina real do depósito?",
      "order": 6,
      "type": "SINGLE",
      "required": true,
      "surveyQuestionOptions": [
        { "label": "Sim, reflete adequadamente a rotina diária.", "value": "sim", "order": 1 },
        { "label": "Parcialmente, exigindo adaptações operacionais.", "value": "parcialmente", "order": 2 },
        { "label": "Não, o fluxo do sistema é distante da prática cotidiana.", "value": "nao", "order": 3 },
        { "label": "N/A. Não utilizo essa funcionalidade.", "value": "na", "order": 4 }
      ]
    },
    {
      "text": "O uso do SISMAN contribuiu para a substituição de registros manuais ou informais por um processo mais transparente, eficiente e padronizado? (1: Discordo totalmente — 5: Concordo totalmente)",
      "order": 7,
      "type": "RATING",
      "required": true
    },
    {
      "text": "O SISMAN aumentou a confiabilidade das informações sobre estoque e movimentação de materiais em relação ao processo anterior? (1: Discordo totalmente — 5: Concordo totalmente)",
      "order": 8,
      "type": "RATING",
      "required": true
    },
    {
      "text": "Como você avalia o impacto do módulo de materiais sobre o comportamento dos profissionais da operação quanto ao uso e controle de materiais?",
      "order": 9,
      "type": "SINGLE",
      "required": true,
      "surveyQuestionOptions": [
        { "label": "Observa-se maior zelo e senso de responsabilidade, devido à rastreabilidade dos materiais.", "value": "maior_zelo", "order": 1 },
        { "label": "Não houve mudança perceptível de comportamento.", "value": "sem_mudanca", "order": 2 },
        { "label": "O registro digital tornou o processo mais burocrático, sem impacto no zelo pelos materiais.", "value": "burocratico", "order": 3 },
        { "label": "N/A. Não possuo elementos suficientes para avaliar.", "value": "na", "order": 4 }
      ]
    },
    {
      "text": "Na sua percepção, o SISMAN contribui para a formalização dos processos, a rastreabilidade das operações e o fortalecimento da governança institucional? (1: Discordo totalmente — 5: Concordo totalmente)",
      "order": 10,
      "type": "RATING",
      "required": true
    },
    {
      "text": "Se fosse possível incluir apenas uma nova funcionalidade no sistema para o módulo de materiais, qual seria?",
      "order": 11,
      "type": "TEXT",
      "required": false
    }
  ]
}